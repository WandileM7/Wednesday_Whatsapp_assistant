# Spotify redirect URIs must be 127.0.0.1 (not localhost) or HTTPS
PUBLIC_URL=http://127.0.0.1:8000
SESSION_SECRET=please-change-me
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Vision: photos sent on WhatsApp (and the see_image tool) get described by a
# small local VLM. Needs `ollama pull moondream` (~1.7GB, runs under 4GB VRAM).
ENABLE_VISION=true
VISION_MODEL=moondream
# Local voice — no API keys needed. Models auto-download on first use.
WHISPER_MODEL=base
PIPER_VOICE=en_US-lessac-medium
# Optional hosted TTS: set a Fish Audio key to use it instead of Piper
# (Piper remains the fallback if a Fish request fails).
FISH_API_KEY=
FISH_VOICE_ID=bf6b1cbc1a394928adfb6927726d8b17
FISH_TTS_MODEL=s2.1-pro-free
FISH_SPEED=1.0
# Kokoro: local, free, and much more natural than Piper (82M params, ONNX).
# Needs `pip install kokoro-onnx`; the model (~310MB) downloads on first use.
# Voices: bf_emma / bf_isabella (British female), bm_george, af_heart, af_bella…
ENABLE_KOKORO=false
KOKORO_VOICE=bf_emma
KOKORO_LANG=en-gb
KOKORO_SPEED=1.0
# Force one TTS engine: fish | kokoro | piper. Empty = pick the best available
# (Fish if keyed, then Kokoro if enabled, then Piper).
TTS_ENGINE=
# Web search, in preference order:
#  1. SearXNG — self-hosted metasearch over ~70 engines, no key, no quota.
#     `docker compose up` starts one; this URL is set for you in compose.
#     Running bare-metal? Point it at your own instance (json format enabled).
#  2. A hosted provider if its key is set — Tavily is LLM-tuned and returns page
#     content directly (best for deep search); Brave is a general web index.
#  3. The free DuckDuckGo scrape, always the last-resort fallback.
SEARXNG_URL=
TAVILY_API_KEY=
BRAVE_API_KEY=
# MCP: every tool on every server listed in mcp.json becomes a Wednesday tool
# (cp mcp.json.example mcp.json to start). Tool schemas ride in every prompt,
# hence the cap. MCP tools ask before running unless you turn that off.
MCP_CONFIG=mcp.json
MCP_MAX_TOOLS=24
MCP_REQUIRE_APPROVAL=true
DATABASE_URL=sqlite+aiosqlite:///./wednesday.db
# Memory retrieval: FTS5 keyword + sqlite-vec semantic search, fused by rank.
# Needs `ollama pull nomic-embed-text`; without it memory silently falls back
# to the lexical scan. The index is a throwaway sidecar file.
ENABLE_MEMORY_EMBEDDINGS=true
EMBED_MODEL=nomic-embed-text
VECTOR_DB_PATH=./wednesday-vectors.db
WAHA_URL=http://whatsapp-service:3000
WHATSAPP_ENABLED=true
# Home Assistant: expose Wednesday over the Wyoming protocol as an STT +
# conversation + TTS service, so HA voice satellites talk to the same brain.
# Add it in HA via Settings → Devices → Add integration → Wyoming Protocol,
# host = this machine, port = 10700. The protocol is unauthenticated: LAN only.
# Needs `pip install wyoming`.
ENABLE_WYOMING=false
WYOMING_URI=tcp://0.0.0.0:10700
WYOMING_LANGUAGE=en
# Which identity HA turns belong to; empty = the same brain as DEFAULT_USER
WYOMING_USER=
# Identity: web UI and the owner's WhatsApp share this user's memory
DEFAULT_USER=wandile
# Your own WhatsApp JID (e.g. 27831234567@s.whatsapp.net) — maps to DEFAULT_USER
WHATSAPP_OWNER_JID=
# Comma-separated JIDs allowed to talk to Wednesday; empty = anyone
WHATSAPP_ALLOWED_JIDS=

# ── iMessage via Photon Spectrum (optional, hosted) ───────────────────────────
# The one channel that isn't self-hosted: messages route through Photon's relay.
# Free tier covers up to 10 users on a shared number pool. Sign up at
# https://photon.codes, then: docker compose --profile imessage up -d
IMESSAGE_ENABLED=false
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
# Your own iMessage handle (E.164 or Apple ID email) — maps to DEFAULT_USER
IMESSAGE_OWNER_HANDLE=
# Comma-separated handles allowed to talk to Wednesday. Unlike WhatsApp, EMPTY
# BLOCKS EVERYONE — the shared number pool means an open door is one stranger
# away. List yourself and anyone else you want answered.
IMESSAGE_ALLOWED_HANDLES=
# Voice notes: auto = voice in, voice out · always = speak every reply ·
# never = text only. Needs ffmpeg in the imessage-service image.
IMESSAGE_VOICE_REPLIES=auto
# Where the backend reaches the sidecar to send replies. The default is the
# docker compose service name; running the backend on the host instead, it does
# not resolve, and every reply dies with "Temporary failure in name resolution"
# after the model has already done the work.
IMESSAGE_SERVICE_URL=http://imessage-service:3100
# Where the sidecar posts inbound messages. Without it the sidecar still starts,
# still connects, and still reports healthy — it just never delivers anything to
# the backend, so Wednesday goes quiet with nothing in either log to say why.
# Use the service name (http://backend:8000/...) under docker compose.
IMESSAGE_HOOK_URL=http://localhost:8000/imessage/webhook
# Bearer token protecting the API + WebSocket; empty disables auth (local dev).
# Set the same value as VITE_API_TOKEN for the frontend and API_TOKEN for the
# whatsapp-service so they can authenticate.
API_TOKEN=
# Proactive check-ins (calendar/email) every N minutes; 0 = off
HEARTBEAT_MINUTES=0
# No proactive pings between these hours (24h clock, wraps midnight)
HEARTBEAT_QUIET=22-07
HEARTBEAT_DAILY_CAP=8
# Sandboxed run_code tool (docker, no network); off by default
ENABLE_CODE_EXECUTION=false
# browse_web: a real headless browser driven by the local model, for pages
# fetch_page can't handle (forms, logins, JS). Needs:
#   pip install browser-use && playwright install chromium
# BROWSER_MODEL empty reuses OLLAMA_MODEL — give it something capable.
ENABLE_BROWSER_USE=false
BROWSER_MODEL=
BROWSER_TIMEOUT=180
# Smaller model for background calls (summaries, memory extraction). Strongly
# recommended: set it to a DIFFERENT (smaller) model than OLLAMA_MODEL. Sharing
# one model makes each background call evict the interactive prompt's KV cache,
# so the next reply re-evaluates the whole ~2.2k-token prefix — seconds become
# minutes. A distinct utility model runs on its own runner and avoids that.
# Empty = reuse OLLAMA_MODEL.
OLLAMA_MODEL_UTILITY=llama3.2:3b
# Tools that pause and ask for approval before running
APPROVAL_REQUIRED_TOOLS=gmail_send,calendar_create_event,run_code,browse_web
# Email channel: Wednesday answers mail sent to this inbox. Use an app
# password. Only EMAIL_ALLOWED_SENDERS get replies; the first listed
# address shares your identity/memory.
EMAIL_ADDRESS=
EMAIL_PASSWORD=
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_POLL_SECONDS=60
EMAIL_ALLOWED_SENDERS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Spotify app must list redirect URI {PUBLIC_URL}/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Read timeout for one interactive model round. Raise it on CPU-only boxes:
# prompt eval at single-digit tok/s plus two or three tool hops can exceed 300s.
OLLAMA_TIMEOUT=300
