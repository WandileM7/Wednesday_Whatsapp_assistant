# Frontend config (Vite). Copy to frontend/.env.local — values are baked into
# the bundle at build time, so rebuild after changing them.

# Bearer token for the backend; must match API_TOKEN in the root .env.
VITE_API_TOKEN=

# Override the WebSocket URL when the backend isn't behind this dev server.
VITE_BACKEND_WS=

# Wake word for hands-free mode. Empty = hands-free sends every utterance it
# hears; set a model name and nothing is sent until the word is spoken.
# Models (openWakeWord, served and cached by the backend):
#   hey_jarvis_v0.1 | alexa_v0.1 | hey_mycroft_v0.1 | hey_rhasspy_v0.1
# Leaving this empty keeps onnxruntime-web out of the bundle entirely; setting
# it splits ort into a ~405KB chunk loaded only when hands-free is switched on.
VITE_WAKE_WORD=
