# Environment
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.venv/

# Local runtime state
wednesday.db
wednesday-vectors.db
test_wednesday.db
test_wednesday-vectors.db
# SQLite WAL sidecars — transient, and they leak recent rows if committed
*.db-shm
*.db-wal
.claude/

# WSL alternate data streams on files copied in from Windows
*:Zone.Identifier
*:sec.endpointdlp

# MCP server list — can hold API tokens in `headers`
mcp.json

# Personal user-model doc (auto-included in the system prompt when present)
okf/user.md

# Skill drafts awaiting review + local usage stats
okf/skills/proposals/
okf/skills/.usage.json

# Node
node_modules/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/

# WhatsApp session data
whatsapp-session/
whatsapp-service/session/
whatsapp-service/uploads/
whatsapp-service/node_modules/

# n8n data (Docker volume)
n8n_data/

# Frontend build output
static/dashboard/
frontend/node_modules/

# Docker
*.pid

# Logs
*.log

# Backups
*.bak
